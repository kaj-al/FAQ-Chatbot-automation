      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst msg = String(body.message || \"\").trim().slice(0, 1000);\nif (!msg) throw new Error(\"message is empty\");\n\nconst now = new Date();\nlet sid = String(body.session_id || \"\").replace(/[^A-Za-z0-9_-]/g, \"\");\nif (!sid) sid = \"anon-\" + now.toISOString().replace(/[^0-9]/g, \"\");\n\nreturn [{ json: { session_id: sid, message: msg, ts: now.toISOString() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        -288
      ],
      "id": "634adb59-ceb2-4f1c-9396-2cfa18f7a8a6",
      "name": "Normalize Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=FAQ:{{ $json.kb }}\nUser question: {{ $json.message }}",
        "options": {
          "systemMessage": "You are a scheduling support assistant.\nAlways reply in the language and script the user last wrote in.\n(Hindi typed in English letters gets a reply in the same style.)\n\nUse ONLY the facts in the FAQ below. If a phone number, time, price or\npolicy is not written in the FAQ, do not state it.\nYou cannot book, change or cancel appointments. Say so if asked.\n\n\nIf the FAQ does not cover the question, say you don't know and that a\nhuman will follow up, then call notify_team with the question.\nNever call notify_team when the FAQ already has the answer.\n\nFAQ:\n{{ $json.kb }}",
          "maxIterations": 3,
          "returnIntermediateSteps": false
        }
      },
